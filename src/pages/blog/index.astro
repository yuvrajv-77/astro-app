---
import { getCollection } from "astro:content";
import Layout from "@/layouts/main.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

// Fetch and sort posts by date descending
const posts = await getCollection("blog");
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout 
  title="Developer Documentation & JSON Guides - DevJSON Sandbox"
  description="Explore comprehensive tutorials and reference documentation for parsing, minifying, and validating JSON data correctly in web applications."
  canonicalUrl="/blog"
  currentActive="blog"
>
  <div class="container mx-auto px-4 py-8 max-w-4xl flex-1 flex flex-col gap-6">
    <div class="border-b border-border pb-4">
      <h1 class="text-2xl md:text-3xl font-heading font-bold tracking-tight text-foreground">
        Developer Documentation & Guides
      </h1>
      <p class="text-xs md:text-sm text-muted-foreground mt-1.5 leading-relaxed">
        Reference manuals, deep dives, and formatting tips to streamline your API and configuration workflows.
      </p>
    </div>

    <!-- Blog Posts Grid -->
    {sortedPosts.length === 0 ? (
      <div class="text-center py-12 text-muted-foreground font-mono text-sm">
        No articles published yet. Check back soon!
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-2">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="group hover:no-underline block">
            <Card className="border-border bg-card hover:bg-secondary/40 transition-all h-full cursor-pointer flex flex-col justify-between">
              <CardHeader className="p-5">
                <div class="flex items-center gap-2 text-[10px] text-muted-foreground font-mono mb-2">
                  <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                  <span>•</span>
                  <span>{post.data.author}</span>
                </div>
                <CardTitle className="text-base font-heading font-semibold text-foreground group-hover:text-primary transition-colors line-clamp-2">
                  {post.data.title}
                </CardTitle>
                <CardDescription className="text-xs text-muted-foreground mt-2 line-clamp-3 leading-relaxed">
                  {post.data.description}
                </CardDescription>
              </CardHeader>
              
              <CardContent className="px-5 pb-5 pt-0 flex flex-wrap gap-1.5 shrink-0">
                {post.data.tags?.map((tag) => (
                  <span class="text-[10px] font-mono bg-secondary px-2 py-0.5 rounded text-secondary-foreground border border-border/40">
                    #{tag}
                  </span>
                ))}
              </CardContent>
            </Card>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
