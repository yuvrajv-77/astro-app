---
import Layout from "@/layouts/main.astro";
import { JSONEditor } from "@/components/JSONEditor";
import { FAQAccordion } from "@/components/FAQAccordion";

const faqItems = [
  {
    id: "faq-1",
    question: "Is it safe to paste confidential credentials or API logs here?",
    answer: "Yes. Unlike standard formatting tools, DevJSON Sandbox processes your input 100% locally in your web browser. No network requests are made when you type or click format. You can check the Network tab in developer tools to verify."
  },
  {
    id: "faq-2",
    question: "How do I use the copy path feature?",
    answer: "Once you load valid JSON, switch to the \"Tree Explorer\" tab. Hover your cursor over any tree node, and the active path will show in the breadcrumbs bar at the bottom. Click any breadcrumb segment to copy the path up to that point, or click 'Copy Path' directly on the node."
  },
  {
    id: "faq-3",
    question: "What format conversions does DevJSON Sandbox support?",
    answer: "You can instantly convert valid JSON data into clean XML structures, CSV spreadsheet formats, or YAML document files. Use the 'Format Converters' buttons inside the central Controls Deck to trigger conversions."
  },
  {
    id: "faq-4",
    question: "How does the Image Hover Previewer work?",
    answer: "If any string value inside your JSON data is a web URL pointing to an image file (e.g. ending in .png, .jpg, .svg, .webp), our Tree Explorer will render a preview eye icon next to the link. Hovering over this icon displays the image overlay dynamically."
  },
  {
    id: "faq-5",
    question: "What metrics are computed in the real-time Diagnostics HUD?",
    answer: "The Diagnostics HUD calculates file byte sizes, total node counts, recursive nesting levels, character/line counts, and the browser's exact JSON parsing speed in milliseconds on every keystroke."
  }
];
const schemaMarkup = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "DevJSON Formatter & Viewer",
    "operatingSystem": "All",
    "applicationCategory": "DeveloperApplication",
    "browserRequirements": "Requires HTML5 compatible browser",
    "description": "Free, secure, and offline-first JSON formatter and viewer. Beautify messy JSON, collapse nodes inside an interactive tree inspector, and copy paths.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  }
];
---

<Layout 
  title="JSON Formatter & Viewer - Free Online Beautifier & Inspector"
  description="Free, secure, and offline-first JSON formatter and viewer. Beautify messy JSON, collapse nodes inside an interactive tree inspector, validate syntax errors, and copy paths. 100% private in-browser tool."
  canonicalUrl="/"
  currentActive="formatter"
  schemaMarkup={schemaMarkup}
>
  <div class="container mx-auto px-4 py-6 flex-1 flex flex-col gap-6">
    <!-- Header introduction -->
    <div class="shrink-0">
      <h1 class="text-2xl md:text-3xl font-heading font-bold tracking-tight text-foreground">
        JSON Formatter & Viewer
      </h1>
      <p class="text-xs md:text-sm text-muted-foreground mt-1.5 leading-relaxed">
        Paste your JSON below to beautify, format, validate, and explore it in an interactive tree view. All processing is done client-side for absolute privacy.
      </p>
    </div>

    <!-- The Interactive Editor Component -->
    <div class="flex-1 flex flex-col min-h-0">
      <JSONEditor client:load mode="formatter" />
    </div>

    <!-- SEO & Documentation Content Section -->
    <section class="border-t border-border/60 pt-10 mt-6 grid grid-cols-1 md:grid-cols-3 gap-8 text-xs leading-relaxed">
      <div class="space-y-4">
        <h2 class="text-base font-heading font-semibold text-foreground tracking-wide">
          What is a JSON Formatter & Viewer?
        </h2>
        <p class="text-muted-foreground">
          JSON (JavaScript Object Notation) is the standard format for exchanging data on the web. It is often minified or compressed to save server bandwidth, making it unreadable. A JSON Formatter takes minified, cluttered JSON and adds proper indentation, line breaks, and whitespace to make it human-readable.
        </p>
        <p class="text-muted-foreground">
          Our <strong>JSON Viewer</strong> takes this a step further by building an interactive tree out of your data. You can expand and collapse nesting levels, hover over specific keys to copy their JSON query path, and search for specific values dynamically.
        </p>

        <h3 class="text-sm font-heading font-medium text-foreground">
          Key Benefits of Client-Side Formatting
        </h3>
        <ul class="list-disc pl-4 space-y-1.5 text-muted-foreground">
          <li><strong>Absolute Privacy:</strong> Your JSON is parsed directly in your browser. None of your logs or API responses are sent to our servers.</li>
          <li><strong>Blazing Fast:</strong> Zero server latency. The formatting and minification are instantaneous.</li>
          <li><strong>Syntax Diagnostics:</strong> Spot missing commas, brackets, or mismatched quotes instantly with clear visual flags.</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h2 class="text-base font-heading font-semibold text-foreground tracking-wide">
          Frequently Asked Questions (FAQ)
        </h2>
        <FAQAccordion items={faqItems} client:load />
      </div>

      <div class="space-y-4">
        <h2 class="text-base font-heading font-semibold text-foreground tracking-wide">
          Pro Tips & Best Practices
        </h2>
        <div class="space-y-3 text-muted-foreground">
          <p>
            <strong>Validate before formatting:</strong> If your JSON payload has hidden syntax errors (like trailing commas or unescaped quotes), formatting might fail. Use our built-in validator flags to clean up structure first.
          </p>
          <p>
            <strong>Keyboard Shortcuts:</strong> Pressing <kbd class="px-1.5 py-0.5 bg-secondary text-foreground text-[10px] rounded border border-border">Ctrl + F</kbd> (or <kbd class="px-1.5 py-0.5 bg-secondary text-foreground text-[10px] rounded border border-border">Cmd + F</kbd>) inside the editor opens a powerful search and replace widget to clean up key-value pairs.
          </p>
          <div class="p-3 border border-border/50 bg-secondary/15 rounded-md space-y-2">
            <h4 class="font-semibold text-foreground text-[11px]">JSON Developer Suite Tools</h4>
            <ul class="space-y-1.5 list-none text-[11px]">
              <li><a href="/json-validator" class="text-primary hover:underline font-medium flex items-center gap-1.5"><span>✓</span> JSON Syntax Validator</a></li>
              <li><a href="/json-minifier" class="text-primary hover:underline font-medium flex items-center gap-1.5"><span>✓</span> JSON Minifier</a></li>
              <li><a href="/json-viewer" class="text-primary hover:underline font-medium flex items-center gap-1.5"><span>✓</span> Interactive Tree Viewer</a></li>
              <li><a href="/json-diff" class="text-primary hover:underline font-medium flex items-center gap-1.5"><span>✓</span> Side-by-Side Diff Viewer</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
