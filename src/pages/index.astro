---
import Layout from "@/layouts/main.astro";
import { JSONEditor } from "@/components/JSONEditor";
import { FAQAccordion } from "@/components/FAQAccordion";

const faqItems = [
  {
    id: "faq-1",
    question: "Is it safe to paste confidential credentials or API logs here?",
    answer: "Yes. Unlike standard formatting tools, DevJSON Sandbox processes your input 100% locally in your web browser. No network requests are made when you type or click format. You can check the Network tab in developer tools to verify."
  },
  {
    id: "faq-2",
    question: "How do I use the copy path feature?",
    answer: "Once you load valid JSON, switch to the \"Tree Explorer\" tab. Hover your cursor over any tree node, and the active path will show in the breadcrumbs bar at the bottom. Click any breadcrumb segment to copy the path up to that point, or click 'Copy Path' directly on the node."
  },
  {
    id: "faq-3",
    question: "What format conversions does DevJSON Sandbox support?",
    answer: "You can instantly convert valid JSON data into clean XML structures, CSV spreadsheet formats, or YAML document files. Use the 'Format Converters' buttons inside the central Controls Deck to trigger conversions."
  },
  {
    id: "faq-4",
    question: "How does the Image Hover Previewer work?",
    answer: "If any string value inside your JSON data is a web URL pointing to an image file (e.g. ending in .png, .jpg, .svg, .webp), our Tree Explorer will render a preview eye icon next to the link. Hovering over this icon displays the image overlay dynamically."
  },
  {
    id: "faq-5",
    question: "What metrics are computed in the real-time Diagnostics HUD?",
    answer: "The Diagnostics HUD calculates file byte sizes, total node counts, recursive nesting levels, character/line counts, and the browser's exact JSON parsing speed in milliseconds on every keystroke."
  },
  {
    id: "faq-6",
    question: "How to view a JSON file online?",
    answer: "To view a JSON file online, open a web-based inspector like DevJSON Sandbox, click the 'Upload File' button or drag and drop your file, or paste your raw JSON string directly into the workspace. The tool will parse and render your data instantly."
  },
  {
    id: "faq-7",
    question: "How to view JSON on Chrome?",
    answer: "You can view JSON on Chrome by using an in-browser utility like DevJSON Sandbox. This eliminates the need to install extensions, giving you a safe and feature-rich environment to pretty-print, validate, and query JSON structures."
  },
  {
    id: "faq-8",
    question: "Is JSON human-readable?",
    answer: "JSON is technically a plain-text structure meant to be human-readable, but APIs and servers often compress or minify it (removing spaces, indentations, and newlines) to save transmission space. Running it through a JSON formatter restores it to a human-friendly format."
  },
  {
    id: "faq-9",
    question: "What is the best JSON viewer?",
    answer: "The best JSON viewer is one that processes data 100% locally in your web browser for security, parses payloads instantly, and provides tree navigation. DevJSON Sandbox fits this description by combining formatting, minifying, diff checking, and validation."
  },
  {
    id: "faq-10",
    question: "How do I open a JSON file in my browser?",
    answer: "To open a JSON file in your browser, drag the `.json` file from your desktop and drop it into the DevJSON Sandbox text editor, or click 'Upload File'. The browser will read and display the content locally without transmitting data to any server."
  },
  {
    id: "faq-11",
    question: "How do I convert a JSON file to readable?",
    answer: "You can convert a JSON file to a readable structure by pasting the raw text or uploading the file to a pretty JSON formatter. The tool inserts proper line endings, indentation spaces, and syntax highlighting colors instantly."
  },
  {
    id: "faq-12",
    question: "Which software opens a JSON file?",
    answer: "Since JSON is plain text, it can be opened by code editors (such as VS Code), simple text editors, or web browsers. For advanced tasks like collapsing nodes, finding keys, and syntax verification, web-based tools like DevJSON Sandbox are ideal."
  },
  {
    id: "faq-13",
    question: "How do I display a JSON file?",
    answer: "You can display a JSON file as a structured tree or flat text. Pasting the content into DevJSON Sandbox lets you inspect it as an interactive tree or convert it into other readable structures like CSV or YAML."
  }
];
const schemaMarkup = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "DevJSON Formatter - Free Online JSON Formatter & Validator",
    "operatingSystem": "All",
    "applicationCategory": "DeveloperApplication",
    "browserRequirements": "Requires HTML5 compatible browser",
    "description": "Free, secure, and offline-first JSON formatter and validator. Beautify, validate, parse, and debug JSON with our pretty JSON formatter and interactive JSON viewer.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  }
];
---

<Layout 
  title="JSON Formatter Online - Pretty JSON Formatter & Validator"
  description="Need a reliable JSON formatter online? Beautify, validate, parse, and debug JSON with our free pretty JSON formatter and validator. 100% private, client-side."
  canonicalUrl="/"
  currentActive="formatter"
  schemaMarkup={schemaMarkup}
>
  <div class="container mx-auto px-4 py-6 flex-1 flex flex-col gap-6">
    <!-- Header introduction -->
    <div class="shrink-0">
      <h1 class="text-2xl md:text-3xl font-heading font-bold tracking-tight text-foreground">
        JSON Formatter & Viewer
      </h1>
      <p class="text-xs md:text-sm text-muted-foreground mt-1.5 leading-relaxed">
        Paste your JSON below to beautify, format, validate, and explore it in an interactive tree view. All processing is done client-side for absolute privacy.
      </p>
    </div>

    <!-- The Interactive Editor Component -->
    <div class="flex-1 flex flex-col min-h-0">
      <JSONEditor client:load mode="formatter" />
    </div>

    <!-- SEO & Documentation Content Section -->
    <section class="border-t border-border/60 pt-12 mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8 text-xs leading-relaxed">
      <!-- Main SEO Content (2 Columns on Large Screens) -->
      <div class="lg:col-span-2 space-y-8 pr-0 lg:pr-6">
        <!-- Article Intro Card -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-heading font-bold text-foreground tracking-tight flex items-center gap-2">
            <span class="text-primary">#</span> Why DevJSON Sandbox is the Ultimate JSON Formatter & Validator
          </h2>
          <p class="text-muted-foreground text-sm leading-relaxed">
            In modern software engineering, data interchange formats are the backbone of application communication. JavaScript Object Notation, widely known as JSON, has emerged as the undisputed standard for REST APIs, configuration files, and database records. However, to minimize bandwidth consumption and speed up network transmissions, API payloads are frequently minified, stripped of whitespaces, and compressed into single-line strings. Reading, debugging, or editing these compressed structures becomes next to impossible. This is where a dedicated <strong class="text-foreground">json formatter</strong> becomes an indispensable tool for any developer's environment. Without a reliable way to expand and color-code these blocks, troubleshooting API responses or analyzing telemetry logs becomes a tedious, time-consuming task.
          </p>
          <p class="text-muted-foreground text-sm leading-relaxed">
            DevJSON Sandbox provides a complete suite of browser-native utilities, starting with an <strong class="text-foreground">online json formatter</strong> that converts raw, unreadable data blocks into clean, structured, and beautifully indented code. Designed for modern developer workflows, this tool combines a <strong class="text-foreground">pretty json formatter</strong> with a high-performance <strong class="text-foreground">json viewer</strong> to give you unparalleled visibility into your data objects. Whether you are dealing with nested objects, arrays, or deep hierarchies, our formatter restores visual structure in a single click, saving you valuable hours of manual debugging.
          </p>
        </div>

        <!-- Two column grid inside the article for features -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
          <!-- Feature Card 1 -->
          <div class="p-5 border border-border/50 bg-card/40 backdrop-blur-sm space-y-3">
            <h3 class="text-sm font-heading font-semibold text-foreground flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-primary/10 text-primary text-[10px]">✔</span>
              JSON Formatter and Validator
            </h3>
            <p class="text-muted-foreground leading-relaxed">
              Unlike basic formatting tools that only add spaces, DevJSON Sandbox functions as a robust <strong class="text-foreground">json formatter and validator</strong>. When you paste your raw string into our workspace, the system executes real-time syntax checking using high-performance parsing libraries. This ensures that any syntax invalidity—such as a misplaced comma, an unescaped double quote, or a missing bracket—is highlighted instantly. By acting as a <strong class="text-foreground">json formatter and validator</strong> in one interface, we eliminate the need for you to bounce between multiple utilities just to find a syntax error. Visual error markers and line-by-line syntax diagnostics guide you exactly to where the JSON specification is violated, allowing you to debug and correct payloads on the fly.
            </p>
          </div>

          <!-- Feature Card 2 -->
          <div class="p-5 border border-border/50 bg-card/40 backdrop-blur-sm space-y-3">
            <h3 class="text-sm font-heading font-semibold text-foreground flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-primary/10 text-primary text-[10px]">✔</span>
              Interactive JSON Viewer
            </h3>
            <p class="text-muted-foreground leading-relaxed">
              Formatting raw text into a readable structure is only half the battle. When dealing with complex datasets—such as multi-megabyte server logs, nesting profiles, or deeply branching API configurations—scrolling through plain text remains inefficient. That is why our platform includes a specialized <strong class="text-foreground">json viewer</strong> panel. The <strong class="text-foreground">online json viewer</strong> takes your formatted payload and automatically builds an interactive, navigable tree diagram of the objects and arrays. You can collapse and expand specific nodes to focus on relevant keys, copy query paths to use in your Javascript code, and search through keys or values dynamically. Our built-in <strong class="text-foreground">json viewer</strong> makes analyzing nested structure simple, turning a wall of text into an actionable map.
            </p>
          </div>
        </div>

        <!-- Security & Conversion Sub-Section -->
        <div class="space-y-6 pt-4">
          <div class="p-6 border border-primary/20 bg-primary/5 space-y-3">
            <h3 class="text-sm font-heading font-semibold text-foreground flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-primary animate-pulse"></span>
              Client-Side Security: A 100% Private JSON Beautifier
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Many developers use an <strong class="text-foreground">online json formatter</strong> to format production API payloads, which often contain sensitive customer profiles, financial details, or authorization tokens. Submitting this data to a standard server-side formatter poses a major security risk.
            </p>
            <p class="text-muted-foreground text-sm leading-relaxed">
              With DevJSON Sandbox, security is built in by design. It functions as a fully offline-first <strong class="text-foreground">online json beautifier</strong>. All operations—formatting, minification, path navigation, and diagnostics—happen locally inside your web browser. None of your data is ever transmitted to a remote server. You can inspect your browser's network tab or run the application completely offline to verify its privacy. This makes it a highly secure <strong class="text-foreground">online json beautifier</strong> or <strong class="text-foreground">json beautifier</strong> you can trust. Since no network requests are sent, you can format credentials and configuration blocks safely, knowing that your sensitive data never leaves your local machine. This client-side execution makes formatting fast and completely private.
            </p>
          </div>

          <div class="space-y-3">
            <h3 class="text-sm font-heading font-semibold text-foreground">
              Seamless Conversion: Convert JSON to CSV with One Click
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              A robust developer tool should adapt to different workflows. Often, engineers, QA teams, or product managers need to export JSON datasets into data analytics platforms or spreadsheets. To address this, our controls panel includes one-click export utilities like <strong class="text-foreground">json to csv</strong> conversion. Within seconds, nested or flat JSON arrays are mapped to standard comma-separated tabular values, ready to be copied or downloaded for import into Microsoft Excel or Google Sheets. In addition, DevJSON Sandbox supports exports to clean XML structure or YAML configuration files, bridging the gap between various platform standards. This <strong class="text-foreground">json to csv</strong> converter operates client-side to keep your exports private.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Sidebar (1 Column on Large Screens) -->
      <div class="space-y-8">
        <div class="space-y-4">
          <h2 class="text-base font-heading font-semibold text-foreground tracking-wide flex items-center gap-1.5">
            <span>❓</span> Frequently Asked Questions (FAQ)
          </h2>
          <FAQAccordion items={faqItems} client:load />
        </div>

        <div class="space-y-4">
          <h2 class="text-base font-heading font-semibold text-foreground tracking-wide flex items-center gap-1.5">
            <span>💡</span> Pro Tips & Best Practices
          </h2>
          <div class="space-y-3 text-muted-foreground">
            <p>
              <strong>Validate before formatting:</strong> If your JSON payload has hidden syntax errors (like trailing commas or unescaped quotes), formatting might fail. Use our built-in validator flags to clean up structure first.
            </p>
            <p>
              <strong>Keyboard Shortcuts:</strong> Pressing <kbd class="px-1.5 py-0.5 bg-secondary text-foreground text-[10px] rounded border border-border">Ctrl + F</kbd> (or <kbd class="px-1.5 py-0.5 bg-secondary text-foreground text-[10px] rounded border border-border">Cmd + F</kbd>) inside the editor opens a powerful search and replace widget to clean up key-value pairs.
            </p>
            <div class="p-4 border border-border bg-card/60 backdrop-blur-sm  space-y-3">
              <h4 class="font-semibold text-foreground text-[11px] uppercase tracking-wider text-muted-foreground">JSON Developer Suite</h4>
              <ul class="space-y-2 list-none text-[11px] p-0 m-0">
                <li><a href="/json-validator" class="text-primary hover:underline font-medium flex items-center gap-2"><span>→</span> JSON Syntax Validator</a></li>
                <li><a href="/json-minifier" class="text-primary hover:underline font-medium flex items-center gap-2"><span>→</span> JSON Minifier</a></li>
                <li><a href="/json-viewer" class="text-primary hover:underline font-medium flex items-center gap-2"><span>→</span> Interactive Tree Viewer</a></li>
                <li><a href="/json-diff" class="text-primary hover:underline font-medium flex items-center gap-2"><span>→</span> Side-by-Side Diff Viewer</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
