---
import Layout from "@/layouts/main.astro";
import { JSONEditor } from "@/components/JSONEditor";
import { FAQAccordion } from "@/components/FAQAccordion";

const faqItems = [
  {
    id: "faq-1",
    question: "When should you format JSON?",
    answer: "You should format JSON during development, debugging, and log inspections. Reading unformatted logs makes identifying configuration issues extremely difficult."
  },
  {
    id: "faq-2",
    question: "When should you minify JSON?",
    answer: "You should minify JSON when sending requests to REST APIs, posting webhooks, returning responses from backend endpoints, or writing static configurations to client bundlers."
  },
  {
    id: "faq-3",
    question: "How secure is this compressor?",
    answer: "Like all tools on DevJSON Sandbox, our minification engine operates 100% locally in your web browser. No server connection is required to minify, meaning your production keys, tokens, and payloads are secure."
  }
];
---

<Layout 
  title="JSON Minifier & Compressor - Compress JSON Online"
  description="Compress and minify JSON data online. Remove all tabs, spacing, indentation, and newlines to optimize network payload size. Free, private, and offline-first JSON compressor."
  canonicalUrl="/minifier"
  currentActive="minifier"
>
  <div class="container mx-auto px-4 py-6 flex-1 flex flex-col gap-6">
    <!-- Header introduction -->
    <div class="shrink-0">
      <h1 class="text-2xl md:text-3xl font-heading font-bold tracking-tight text-foreground">
        JSON Minifier & Compressor
      </h1>
      <p class="text-xs md:text-sm text-muted-foreground mt-1.5 max-w-2xl leading-relaxed">
        Strip all unnecessary whitespace, carriage returns, and newlines from your JSON payload. Optimize your data structures for network transmissions and API payloads.
      </p>
    </div>

    <!-- The Interactive Editor Component -->
    <div class="flex-1 flex flex-col min-h-0">
      <JSONEditor client:load mode="minifier" />
    </div>

    <!-- SEO & Documentation Content Section -->
    <section class="border-t border-border/60 pt-10 mt-6 grid grid-cols-1 md:grid-cols-2 gap-8 text-xs leading-relaxed max-w-5xl">
      <div class="space-y-4">
        <h2 class="text-base font-heading font-semibold text-foreground tracking-wide">
          What is JSON Minification?
        </h2>
        <p class="text-muted-foreground">
          JSON minification is the process of stripping all formatting whitespace, newlines, tabs, and indentation from a JSON structure. While formatted JSON is excellent for human debugging, it is highly inefficient for data transfers. Minifying JSON compiles the payload into a single, continuous string.
        </p>
        <p class="text-muted-foreground">
          A minified JSON payload is functionally identical to its formatted counterpart, but has a significantly smaller file size. This speeds up API load times and reduces data transmission costs for servers and clients alike.
        </p>

        <h3 class="text-sm font-heading font-medium text-foreground">
          Why Compressing JSON Matters
        </h3>
        <ul class="list-disc pl-4 space-y-1.5 text-muted-foreground">
          <li><strong>Reduce Bandwidth Consumption:</strong> Stripping whitespace from deep JSON payloads can reduce data footprint by 15% to 40% depending on the nesting density.</li>
          <li><strong>Accelerate API Performance:</strong> Smaller payloads mean faster TCP/IP packet transmission and reduced network latency.</li>
          <li><strong>Optimized Databases:</strong> Storing compressed JSON strings in databases (like MongoDB, PostgreSQL jsonb, or Redis) saves storage volume and improves query indexing speed.</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h2 class="text-base font-heading font-semibold text-foreground tracking-wide">
          JSON Formatting vs. Minification
        </h2>
        
        <FAQAccordion items={faqItems} client:load />
      </div>
    </section>
  </div>
</Layout>
