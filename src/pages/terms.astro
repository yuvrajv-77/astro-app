---
import Layout from "@/layouts/main.astro";
---

<Layout 
  title="Terms of Service - DevJSON Sandbox"
  description="Terms of Service for DevJSON Sandbox. Read about the conditions of use and standard developer liability disclaimers."
  canonicalUrl="/terms"
  currentActive="blog"
>
  <div class="container mx-auto px-4 py-8 max-w-3xl flex-1 flex flex-col gap-6">
    <div class="border-b border-border pb-4">
      <h1 class="text-2xl md:text-3xl font-heading font-bold tracking-tight text-foreground">
        Terms of Service
