---
import "@/styles/global.css"
import { FontSizeSelector } from "@/components/FontSizeSelector";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  currentActive?: "formatter" | "validator" | "minifier" | "viewer" | "blog" | "diff";
  schemaMarkup?: Record<string, any> | Record<string, any>[];
}

const {
  title = "DevJSON Sandbox - Free Online JSON Viewer, Formatter & Validator",
  description = "An offline-first, private-by-design developer utility suite. Format, beautify, validate, minify, and inspect JSON in an interactive tree view. No data ever leaves your computer.",
  canonicalUrl,
  ogType = "website",
  currentActive = "formatter",
  schemaMarkup,
} = Astro.props;

// Build absolute canonical URL
const siteUrl = "https://devjsonsandbox.pages.dev"; // Placeholders replaced with clean static production domain
const finalCanonical = canonicalUrl ? `${siteUrl}${canonicalUrl}` : siteUrl;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Theme & Font setup script to prevent layout/size flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);

      // Font sizes setup
      const uiSize = (typeof localStorage !== 'undefined' && localStorage.getItem('ui-font-size')) || 'ui-fs-md';
      document.documentElement.classList.add(uiSize);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={finalCanonical} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={finalCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}/og-image.png`} />

    {schemaMarkup && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaMarkup)} />
    )}
  </head>
  <body class="bg-background text-foreground min-h-screen flex flex-col font-mono selection:bg-primary/20">
    <!-- Header -->
    <header class="border-b border-border sticky top-0 bg-background z-50">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center gap-2 font-heading font-semibold text-lg tracking-tight hover:opacity-90">
            <span class="text-primary font-bold">{`{}`}</span>
            <span>DevJSON<span class="text-muted-foreground font-light font-mono text-sm ml-1">Sandbox</span></span>
          </a>
          
          <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
            <a 
              href="/" 
              class={`px-3 py-1.5 rounded-md transition-colors ${currentActive === 'formatter' ? 'bg-secondary text-secondary-foreground font-semibold' : 'text-muted-foreground hover:text-foreground'}`}
            >
              Formatter
            </a>
            <a 
              href="/json-validator" 
              class={`px-3 py-1.5 rounded-md transition-colors ${currentActive === 'validator' ? 'bg-secondary text-secondary-foreground font-semibold' : 'text-muted-foreground hover:text-foreground'}`}
            >
              Validator
            </a>
            <a 
              href="/json-minifier" 
              class={`px-3 py-1.5 rounded-md transition-colors ${currentActive === 'minifier' ? 'bg-secondary text-secondary-foreground font-semibold' : 'text-muted-foreground hover:text-foreground'}`}
            >
              Minifier
            </a>
            <a 
              href="/json-viewer" 
              class={`px-3 py-1.5 rounded-md transition-colors ${currentActive === 'viewer' ? 'bg-secondary text-secondary-foreground font-semibold' : 'text-muted-foreground hover:text-foreground'}`}
            >
              Viewer
            </a>
            <a 
              href="/json-diff" 
              class={`px-3 py-1.5 rounded-md transition-colors ${currentActive === 'diff' ? 'bg-secondary text-secondary-foreground font-semibold' : 'text-muted-foreground hover:text-foreground'}`}
            >
              Diff Tool
            </a>
            <a 
              href="/blog" 
              class={`px-3 py-1.5 rounded-md transition-colors ${currentActive === 'blog' ? 'bg-secondary text-secondary-foreground font-semibold' : 'text-muted-foreground hover:text-foreground'}`}
            >
              Guides
            </a>
          </nav>
        </div>

        <div class="flex items-center gap-1.5">
          <!-- Font Size Selector -->
          <div class="hidden sm:flex items-center gap-2 border-r border-border pr-2 mr-0.5">
            <FontSizeSelector client:load />
          </div>

          <!-- Light/Dark Mode Button -->
          <button 
            id="theme-toggle" 
            class="text-muted-foreground hover:text-foreground transition-colors p-2 rounded-md hover:bg-secondary/50 cursor-pointer"
            title="Toggle Light/Dark Theme"
            aria-label="Toggle Theme"
          >
            <!-- Sun icon (shows in light theme) -->
            <svg id="theme-toggle-light-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
            </svg>
            <!-- Moon icon (shows in dark theme) -->
            <svg id="theme-toggle-dark-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <a 
            href="https://github.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-muted-foreground hover:text-foreground transition-colors p-2 rounded-md hover:bg-secondary/50"
            title="View Code on GitHub"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Mobile Navigation Drawer Link Bar (visible on small viewports) -->
      <div class="md:hidden flex border-t border-border overflow-x-auto divide-x divide-border text-xs scrollbar-none">
        <a href="/" class={`flex-1 text-center py-2.5 transition-colors whitespace-nowrap px-4 ${currentActive === 'formatter' ? 'bg-secondary/70 text-foreground font-semibold' : 'text-muted-foreground'}`}>
          Formatter
        </a>
        <a href="/json-validator" class={`flex-1 text-center py-2.5 transition-colors whitespace-nowrap px-4 ${currentActive === 'validator' ? 'bg-secondary/70 text-foreground font-semibold' : 'text-muted-foreground'}`}>
          Validator
        </a>
        <a href="/json-minifier" class={`flex-1 text-center py-2.5 transition-colors whitespace-nowrap px-4 ${currentActive === 'minifier' ? 'bg-secondary/70 text-foreground font-semibold' : 'text-muted-foreground'}`}>
          Minifier
        </a>
        <a href="/json-viewer" class={`flex-1 text-center py-2.5 transition-colors whitespace-nowrap px-4 ${currentActive === 'viewer' ? 'bg-secondary/70 text-foreground font-semibold' : 'text-muted-foreground'}`}>
          Viewer
        </a>
        <a href="/json-diff" class={`flex-1 text-center py-2.5 transition-colors whitespace-nowrap px-4 ${currentActive === 'diff' ? 'bg-secondary/70 text-foreground font-semibold' : 'text-muted-foreground'}`}>
          Diff Tool
        </a>
        <a href="/blog" class={`flex-1 text-center py-2.5 transition-colors whitespace-nowrap px-4 ${currentActive === 'blog' ? 'bg-secondary/70 text-foreground font-semibold' : 'text-muted-foreground'}`}>
          Guides
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-border bg-card py-10 mt-auto text-sm text-muted-foreground">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="font-heading font-semibold text-foreground mb-3 tracking-wide">DevJSON Sandbox</h3>
            <p class="max-w-xs text-xs leading-relaxed">
              A private, fast, and feature-rich toolbox for parsing, cleaning, and validating JSON data. Designed exclusively for developer workflows.
            </p>
          </div>
          <div>
            <h3 class="font-heading font-semibold text-foreground mb-3 tracking-wide">Security & Privacy</h3>
            <p class="max-w-xs text-xs leading-relaxed">
              <strong>100% Offline Processing:</strong> All JSON formatting, minification, and parsing happen entirely inside your web browser. We never transmit your JSON data to any server.
            </p>
          </div>
          <div>
            <h3 class="font-heading font-semibold text-foreground mb-3 tracking-wide">Navigation</h3>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-primary transition-colors">JSON Formatter & Viewer</a></li>
              <li><a href="/json-validator" class="hover:text-primary transition-colors">JSON Validator</a></li>
              <li><a href="/json-minifier" class="hover:text-primary transition-colors">JSON Minifier</a></li>
              <li><a href="/json-viewer" class="hover:text-primary transition-colors">JSON Tree Viewer</a></li>
              <li><a href="/json-diff" class="hover:text-primary transition-colors">JSON Diff Viewer</a></li>
              <li><a href="/blog" class="hover:text-primary transition-colors">Guides & Tutorials</a></li>
            </ul>
          </div>
        </div>
        
        <div class="border-t border-border mt-8 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
          <div class="flex flex-col md:flex-row items-center gap-4">
            <p>&copy; {new Date().getFullYear()} DevJSON Sandbox. All rights reserved.</p>
            <span class="hidden md:inline text-muted-foreground/30">|</span>
            <div class="flex gap-3">
              <a href="/privacy" class="hover:text-primary transition-colors">Privacy Policy</a>
              <span class="text-muted-foreground/30">&bull;</span>
              <a href="/terms" class="hover:text-primary transition-colors">Terms of Service</a>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="inline-flex items-center gap-1.5 text-primary">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              All Systems Operational
            </span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Script to toggle light/dark theme dynamically -->
    <script>
      const themeToggleBtn = document.getElementById('theme-toggle');
      const lightIcon = document.getElementById('theme-toggle-light-icon');
      const darkIcon = document.getElementById('theme-toggle-dark-icon');

      function updateIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          lightIcon?.classList.remove('hidden');
          darkIcon?.classList.add('hidden');
        } else {
          lightIcon?.classList.add('hidden');
          darkIcon?.classList.remove('hidden');
        }
      }

      // Initial icon alignment
      updateIcons();

      themeToggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });

      // Font size selectors management handled by FontSizeSelector React component
    </script>
  </body>
</html>
